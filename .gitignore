# Build output — build.sh regenerates all of this.
.build/
build/
.swiftpm/
*.xcuserstate
xcuserdata/
.DS_Store

# Python's bytecode cache, left in Tests/ by the probe scripts.
__pycache__/

# Signing material that's tied to one Apple Developer account and should
# never be committed, even though the scripts happily run without it.
*.provisionprofile
*.p12
*.mobileprovision

# Local QA evidence, credentials and environment files.
artifacts/
.env
.env.*
!.env.example
*.key
